datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String @map("role_id")

  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum AuthProvider {
  GOOGLE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Type {
  MCQ
  NUMERIC
}

enum Mode {
  PRACTICE
  TEST
}

model User {
  id    String @id @default(uuid())
  email String @unique @db.VarChar(200)
  name  String @db.VarChar(255)
  roleId String @map("role_id")
  roleRef Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)

  avatar String? @default("https://dicebear.com")
  bio    String? @default("Aptitude learner")

  currentStreak Int?      @map("current_streak")
  longestStreak Int?      @map("longest_streak")
  lastSolvedDate DateTime? @map("last_solved_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  authAccounts AuthAccount[]
  authSessions AuthSession[]

  profile Profile?

  practiceSessions PracticeSession[]
  attempts         Attempt[]
  userBadges       UserBadge[]
  discussions      Discussion[]
  comments         Comment[]
  replies          Reply[]
  discussionLikes  DiscussionLike[]

  @@index([roleId])
  @@map("users")
}

model AuthAccount {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  provider       AuthProvider @map("provider")
  providerUserId String       @map("provider_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_accounts")
}

model AuthSession {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  // SHA-256 hash of the opaque refresh token. Raw token never stored.
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("auth_sessions")
}

model Profile {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique @map("user_id")

  displayName String  @db.VarChar(100)
  handle      String? @unique @db.VarChar(50)
  avatarUrl   String? @db.Text
  bio         String? @db.Text
  gender      String? @db.VarChar(20)
  dateOfBirth DateTime? @db.Date @map("date_of_birth")
  location    String? @db.VarChar(120)

  githubUrl   String? @db.Text @map("github_url")
  linkedinUrl String? @db.Text @map("linkedin_url")
  leetcodeUrl String? @db.Text @map("leetcode_url")
  xUrl        String? @db.Text @map("x_url")
  websiteUrl  String? @db.Text @map("website_url")

  targetCompanies   Json? @map("target_companies")
  dailyQuestionGoal Int?  @default(20) @map("daily_question_goal")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

// Achievements (Phase 6). Badge = definition row seeded from code (never
// created via API in V1). UserBadge = earned join; UNIQUE(userId, badgeId)
// makes double-earning impossible at the DB level (P2002 is the race guard).
model Badge {
  id          String @id @default(uuid())
  code        String @unique @db.VarChar(50)
  name        String @db.VarChar(100)
  description String @db.Text
  icon        String? @db.VarChar(100)
  category    String @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  badge   Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  badgeId String @map("badge_id")

  earnedAt DateTime @default(now()) @map("earned_at")

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@map("user_badges")
}

model Topic {
  id          String @id @default(uuid())
  title       String @db.VarChar(255)
  description String @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subtopics Subtopic[]

  @@map("topics")
}

model Subtopic {
  id          String @id @default(uuid())
  title       String @db.VarChar(255)
  description String @db.Text

  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId String @map("topic_id")

  questions        Question[]
  practiceSessions PracticeSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([topicId])
  @@map("subtopics")
}

model Question {
  id         String @id @default(uuid())
  title      String @db.Text
  difficulty Difficulty @default(EASY)
  type       Type @default(MCQ)
  solution   String @db.Text

  subtopic   Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  subtopicId String   @map("subtopic_id")

  options        Option[]
  sheetQuestions SheetQuestion[]
  attempts       Attempt[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([subtopicId])
  @@map("questions")
}

model Option {
  id        String @id @default(uuid())
  text      String @db.VarChar(255)
  isCorrect Boolean @default(false)

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String   @map("question_id")

  attempts Attempt[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([questionId])
  @@map("options")
}

model Sheet {
  id            String @id @default(uuid())
  title         String @db.VarChar(255)
  description   String @db.Text
  companyName   String @db.VarChar(255)
  difficulty    Difficulty @default(MEDIUM)
  estimatedTime String @default("1:00")

  sheetQuestions SheetQuestion[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sheets")
}

model SheetQuestion {
  id String @id @default(uuid())

  sheet      Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  sheetId    String @map("sheet_id")
  questionId String @map("question_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sheetId])
  @@index([questionId])
  @@unique([sheetId, questionId])
  @@map("sheet_questions")
}

model PracticeSession {
  id String @id @default(uuid())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtopic  Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)

  userId     String @map("user_id")
  subtopicId String @map("subtopic_id")

  mode                 Mode @default(PRACTICE)
  currentQuestionIndex Int @default(0)
  completed            Boolean @default(false)

  startedAt   DateTime @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  attempts Attempt[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([subtopicId])
  @@map("practice_sessions")
}

model Attempt {
  id String @id @default(uuid())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session        PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Option          @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  userId           String @map("user_id")
  sessionId        String @map("session_id")
  questionId       String @map("question_id")
  selectedOptionId String @map("selected_option_id")

  isCorrect Boolean

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([sessionId])
  @@index([questionId])
  @@unique([sessionId, questionId])
  @@map("attempts")
}

model Discussion {
  id      String @id @default(uuid())
  title   String @db.VarChar(255)
  content String @db.Text

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  comments Comment[]
  likes    DiscussionLike[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("discussions")
}

model Comment {
  id      String @id @default(uuid())
  content String @db.Text

  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  discussionId String @map("discussion_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  replies Reply[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([discussionId])
  @@index([userId])
  @@map("comments")
}

model Reply {
  id      String @id @default(uuid())
  content String @db.Text

  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String @map("comment_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([commentId])
  @@index([userId])
  @@map("replies")
}

model DiscussionLike {
  id String @id @default(uuid())

  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  discussionId String @map("discussion_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([discussionId, userId])
  @@index([discussionId])
  @@index([userId])
  @@map("discussion_likes")
}